# Local example values. No real secrets: everything here matches docker-compose.yml.
APP_ENV=local
INSTANCE_ID=local-1
LOG_LEVEL=info
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL
DATABASE_URL=postgres://wager:wager@localhost:5432/wager?sslmode=disable
DB_MAX_CONNS=20
DB_AUTO_MIGRATE=true

# OIDC (Keycloak realm "wager"). The issuer is the public URL embedded in the
# tokens; the JWKS URL may point to an internal hostname.
OIDC_ISSUER=http://localhost:8081/realms/wager
OIDC_JWKS_URL=http://localhost:8081/realms/wager/protocol/openid-connect/certs
OIDC_AUDIENCE=wager-api

# SQS (LocalStack). Static test credentials; on AWS use the default chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo
SQS_CONSUMER_NAME=wager-transactions-consumer
SQS_WAIT_TIME=5s
SQS_VISIBILITY_TIMEOUT=30s
SQS_MAX_MESSAGES=10
SQS_CONSUMER_WORKERS=4
SQS_CONSUMER_ENABLED=true

# Outbox publisher
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_BASE_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m

# Pending reference worker
PENDING_WORKER_ENABLED=true
PENDING_POLL_INTERVAL=1s
PENDING_BASE_BACKOFF=1s
PENDING_MAX_BACKOFF=1m
PENDING_MAX_ATTEMPTS=10
WORKER_SHUTDOWN_TIMEOUT=20s

# Test-only fault injection: consumer.after_commit | outbox.after_claim | outbox.after_publish
# CRASH_POINT=
